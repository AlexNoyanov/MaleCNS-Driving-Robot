[Unit]
Description=Fly Brain Robot Pi agent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=__USER__
Group=__USER__
SupplementaryGroups=dialout video
WorkingDirectory=__REPO__
EnvironmentFile=-/etc/default/fly-brain-robot
ExecStart=/usr/bin/python3 __REPO__/pi/robot_agent.py --mac-host ${MAC_HOST} --mac-port ${MAC_PORT} --usb-camera
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
